<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-scoped NuGet configuration.

  <clear /> is deliberate: the machine-level configuration on some developer
  workstations registers private feeds that are unreachable from CI and from
  clean checkouts. Restore must be reproducible from a bare clone, so the
  repository pins its own source list rather than inheriting one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
