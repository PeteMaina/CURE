<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests — require a real PostgreSQL instance.

    These cover the guarantees that cannot be proven without the database:
    tenant isolation under Row-Level Security, unique constraints, concurrency
    conflicts and transactional rollback.

    They are written to SKIP with an explicit message unless both
    CURE_TEST_POSTGRES_ADMIN_CONNECTION and CURE_TEST_POSTGRES_APP_CONNECTION
    are set, so `dotnet test` stays green on a bare checkout. A skipped
    isolation test is reported as skipped — never as a pass. Run
    `docker compose up -d postgres`, initialize the schema through the API, and
    provide separate migration/admin and restricted runtime connection strings.
  -->

  <PropertyGroup>
    <RootNamespace>CURE.Integration.Tests</RootNamespace>
    <AssemblyName>CURE.Integration.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\CURE.Domain\CURE.Domain.csproj" />
    <ProjectReference Include="..\..\backend\CURE.Application\CURE.Application.csproj" />
    <ProjectReference Include="..\..\backend\CURE.Infrastructure\CURE.Infrastructure.csproj" />
  </ItemGroup>

</Project>
